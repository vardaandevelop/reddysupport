# Base URL of the self-hosted Node.js + Express backend (no trailing slash).
# REST:      ${VITE_API_URL}/api
# Socket.IO: ${VITE_API_URL}/socket.io
#
# Empty  -> MOCK mode (browser mock database, current tested flow)
# Set    -> API mode  (VPS backend)
#
# Frontend env vars are public: never put passwords, database credentials,
# API secrets or private tokens here.
VITE_API_URL=
